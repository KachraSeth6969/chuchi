<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed/Hover state -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/lavender_dark"/>
            <corners android:radius="8dp"/>
            <stroke android:width="1dp" android:color="@color/neutral_400"/>
        </shape>
    </item>
    
    <!-- Normal state - matching your website's View Gallery button -->
    <item>
        <shape>
            <solid android:color="@color/lavender_primary"/>
            <corners android:radius="8dp"/>
            <stroke android:width="1dp" android:color="@color/neutral_300"/>
        </shape>
    </item>
</selector>